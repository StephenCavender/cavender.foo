---
import { getCollection } from "astro:content";
import SnapshotEntry from "@components/SnapshotEntry.astro";

export async function getStaticPaths() {
  const entries = await getCollection("ai");

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<SnapshotEntry entry={entry} label="AI" basePath="/ai" />
