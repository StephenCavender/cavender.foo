---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

// Archived projects sink to the bottom; everything else is alphabetical.
const projects = (await getCollection("projects")).sort(
  (a, b) =>
    Number(a.data.status === "archived") -
      Number(b.data.status === "archived") ||
    a.data.name.localeCompare(b.data.name)
);
---

<BaseLayout>
  <h2>Projects</h2>
  <section>
    <ul>
      {
        projects.map((project) => (
          <li>
            <a href={`/projects/${project.id}/`}>{project.data.name}</a>
            {project.data.status === "archived" && " (archived)"}
            <p>{project.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
<style>
  li {
    margin-bottom: 1rem;
  }
  p {
    margin: 0.15rem 0 0;
    color: var(--text-secondary);
  }
</style>
