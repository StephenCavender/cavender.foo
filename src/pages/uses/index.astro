---
import { getCollection } from "astro:content";
import SnapshotIndex from "@components/SnapshotIndex.astro";

const entries = await getCollection("uses");
---

<SnapshotIndex
  title="What I Use"
  heading="Uses"
  basePath="/uses"
  entries={entries}
>
  <p>Tools and gear I use for work, play, and everything in between.</p>
</SnapshotIndex>
