---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { sortByPubDate } from "../utils/date";
import { RECENT_ARTICLES_COUNT } from "../consts";
const recentArticles = sortByPubDate(await getCollection("articles")).slice(
  0,
  RECENT_ARTICLES_COUNT
);
---

<BaseLayout>
  <section>
    <p>
      Hi, my name is Steve. I'm a believer, husband, father, and developer. If
      you want, there's <a href="/about">more</a>.
    </p>
  </section>

  <section>
    <h2>This Place</h2>
    <p>
      You've found my digital garden: a place for me to jot, write, or whatever
      else.
    </p>
  </section>

  <section>
    <p>Here's a <a href="/now">now</a> page to see what I'm currently up to.</p>
  </section>

  <section>
    <h2>Recent Writing</h2>
    <ul>
      {
        recentArticles.map((article) => (
          <li>
            <a href={`/articles/${article.id}/`}>{article.data.title}</a>
          </li>
        ))
      }
    </ul>
    <p><a href="/articles">See all</a></p>
  </section>

  <section>
    <h2>Links</h2>
    <ul>
      <li><a href="/uses">My uses page</a></li>
      <li><a href="/blogroll">Blogroll</a></li>
      <li><a href="/ai">How I use AI</a></li>
      <li><a href="/bookmarks">Bookmarks</a></li>
      <li><a href="/books">My bookshelf</a></li>
      <li><a href="/games">My gameshelf</a></li>
      <li><a href="/if">Favorite Poem</a></li>
    </ul>
  </section>
</BaseLayout>
