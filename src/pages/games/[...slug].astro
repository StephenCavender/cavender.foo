---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const games = await getCollection("games");
  return games.map((game) => ({
    params: { slug: game.id },
    props: game,
  }));
}
type Props = CollectionEntry<"games">;

const game = Astro.props;
const { Content } = await render(game);
---

<BaseLayout>
  <article class="game">
    <header>
      {
        game.data.cover && (
          <div class="game-cover">
            <Image src={game.data.cover} alt={`Cover for ${game.data.title}`} />
            {game.data.coverSource && (
              <a
                class="cover-credit"
                href={game.data.coverSource}
                rel="noopener nofollow"
                target="_blank"
                title={`Cover artwork source: ${new URL(game.data.coverSource).hostname}`}
              >
                art source
              </a>
            )}
          </div>
        )
      }

      <h1>{game.data.title}</h1>

      <p class="game-status">
        <span class="status-badge status-{game.data.status}">
          {game.data.status}
        </span>
      </p>

      {
        game.data.rating && (
          <div class="game-rating">
            <span class="stars">
              {"★".repeat(game.data.rating)}
              {"☆".repeat(5 - game.data.rating)}
            </span>
            <span class="rating-text">{game.data.rating} / 5</span>
          </div>
        )
      }

      {
        game.data.platform && game.data.platform.length > 0 && (
          <p class="meta-line">
            <span class="meta-label">Platform:</span>{" "}
            {game.data.platform.join(", ")}
          </p>
        )
      }
      {
        game.data.playDate && (
          <p class="meta-line">
            <span class="meta-label">Played:</span>{" "}
            {game.data.playDate.toLocaleDateString()}
          </p>
        )
      }
    </header>

    <div class="game-content prose">
      <Content />
    </div>

    {
      game.data.tags && game.data.tags.length > 0 && (
        <div class="tags">
          {game.data.tags.map((tag) => (
            <a href={`/games/tags/${tag}/`}>#{tag}</a>
          ))}
        </div>
      )
    }

    <a href="/games">Back to Games</a>
  </article>
</BaseLayout>

<style>
  .game {
    max-width: 800px;
    margin: 0 auto;
  }

  header {
    margin-bottom: 2rem;
  }

  .game-cover {
    position: relative;
    width: fit-content;
    float: right;
    margin: 0 0 1.5rem 2rem;
  }

  .cover-credit {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0.2rem 0.45rem;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 8px;
    background: rgba(0, 0, 0, 0.65);
    color: white;
    font-size: 0.65rem;
    line-height: 1;
    text-decoration: none;
    opacity: 0.65;
    transition: opacity 0.15s ease;
  }

  .cover-credit:hover,
  .cover-credit:focus-visible {
    opacity: 1;
    text-decoration: underline;
  }

  .game-cover img {
    max-width: 320px;
    height: auto;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    display: block;
  }

  h1 {
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .game-status {
    margin-bottom: 0.75rem;
  }

  .status-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: bold;
    text-transform: uppercase;
    line-height: 1;
  }

  .status-playing {
    background-color: var(--status-active);
    color: white;
  }

  .status-played {
    background-color: var(--status-done);
    color: white;
  }

  .status-unplayed {
    background-color: var(--status-neutral);
    color: white;
  }

  .game-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 1rem;
  }

  .stars {
    color: var(--text-secondary);
    font-size: 1.2rem;
  }

  .rating-text {
    color: var(--text-secondary);
  }

  .meta-line {
    margin: 0.35rem 0;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .meta-label {
    font-weight: bold;
    color: var(--text-primary);
  }

  .meta-line a {
    color: var(--text-link);
    text-decoration: none;
  }

  .meta-line a:hover {
    text-decoration: underline;
  }

  .game-content {
    clear: both;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .game-cover {
      float: none;
      margin: 0 auto 1.5rem auto;
      text-align: center;
    }
  }
</style>
