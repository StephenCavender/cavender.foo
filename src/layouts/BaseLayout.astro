---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header/index.astro";
import Footer from "@components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title?: string;
  description?: string;
  ogImage?: URL;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogImage,
  pubDate,
  updatedDate,
  tags,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
    />
  </head>
  <body>
    <div class="container">
      <Header title={SITE_TITLE} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <style>
      .container {
        width: 100%;
        max-width: 720px;
        margin: auto;
        padding: 1em;
      }
      main {
        margin-top: 2em;
      }
    </style>
  </body>
</html>
