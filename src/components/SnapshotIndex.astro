---
import { render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SnapshotEntry } from "../utils/snapshots";
import { formatDate, sortByPubDate } from "../utils/date";

interface Props {
  /** Document title, e.g. "What I'm Up To". */
  title: string;
  /** Page heading, e.g. "Now". */
  heading: string;
  /** Collection root, e.g. "/now". Archive links hang off this. */
  basePath: string;
  entries: SnapshotEntry[];
}

const { title, heading, basePath, entries } = Astro.props;

const sortedEntries = sortByPubDate(entries);

const latest = sortedEntries[0];
const previous = sortedEntries.slice(1);

const { Content: LatestContent } = latest
  ? await render(latest)
  : { Content: null };

const formattedDate = latest ? formatDate(latest.data.pubDate) : "";
---

<BaseLayout title={title}>
  <div class="snapshot-content">
    <h1>{heading}</h1>
    <slot />
    <p><em>Updated {formattedDate}</em></p>

    {
      latest && LatestContent ? (
        <div class="latest">
          <div class="content">
            <LatestContent />
          </div>
        </div>
      ) : (
        <div class="no-content">
          <p>No entries found.</p>
        </div>
      )
    }

    {
      previous.length > 0 && (
        <div class="history-section">
          <details>
            <summary class="history-toggle">
              View Previous Versions ({previous.length})
            </summary>
            <ul>
              {previous.map((entry) => {
                const entryDate = formatDate(entry.data.pubDate);

                return (
                  <li>
                    <a href={`${basePath}/${entry.id}/`}>{entryDate}</a>
                  </li>
                );
              })}
            </ul>
          </details>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .snapshot-content {
    max-width: 65ch;
  }

  .latest {
    margin-bottom: 2rem;
  }

  .content {
    margin-bottom: 1rem;
  }

  .history-section {
    margin-top: 2rem;
    border-top: 1px solid var(--border-color);
    padding-top: 2rem;
  }

  .history-toggle {
    cursor: pointer;
    font-weight: 600;
    padding: 0.5rem 0;
    color: var(--accent-color);
    transition: color 0.2s ease;
  }

  .history-toggle:hover {
    color: var(--accent-hover);
  }
</style>
