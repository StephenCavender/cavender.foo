---
interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString("en-us", {
      year: "numeric",
      month: "short",
      day: "numeric",
      // Frontmatter dates are date-only, so they parse as midnight UTC.
      // Without this, viewers west of UTC see the previous day.
      timeZone: "UTC",
    })
  }
</time>
